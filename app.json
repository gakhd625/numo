{
  "expo": {
    "name": "Numo",
    "slug": "numo-finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/numo-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#10B981"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.numo.finance"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/numo-logo.png",
        "backgroundColor": "#10B981"
      },
      "package": "com.numo.finance"
    },
    "web": {
      "favicon": "./assets/numo-logo.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c3aa979b-0b57-48c4-b948-aca1b7089034"
      }
    }
  }
}
